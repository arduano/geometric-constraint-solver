{
  "schema": 1,
  "description": "Conservative release input ownership; unknown files affect every stage.",
  "prose": [
    "docs/**",
    "START_HERE.md",
    "ARCHITECTURE.md",
    "PLAN.md",
    "ACCEPTANCE.md",
    "README.md",
    "REFERENCES.md",
    "OVERNIGHT_REPORT.md"
  ],
  "global": [
    "Cargo.toml",
    "Cargo.lock",
    "shell.nix",
    "rust-toolchain*",
    ".cargo/**",
    "**/Cargo.toml",
    "**/package-lock.json",
    "**/package.json",
    "AGENTS.md",
    ".agents/**",
    "scripts/release-gate.sh",
    "scripts/release_gate.py",
    "scripts/release_policy.json",
    "scripts/tests/test_release_gate.py",
    "scripts/golden_oracle.py",
    "scripts/golden_oracle_test.py",
    "scripts/release_gate_native.py",
    "scripts/release_gate_wasm.py",
    "scripts/tests/test_release_gate_wasm.py",
    "scripts/tests/test_release_profiles.py",
    "scripts/release_browser.py",
    "scripts/release_browser_context.py",
    "scripts/release_equivalence.py",
    "scripts/release_equivalence.json",
    "scripts/tests/test_release_equivalence.py",
    "scripts/tests/test_release_browser_reuse.py",
    "scripts/tests/test_release_inputs.py",
    "scripts/tests/test_release_frontend.py",
    "scripts/release_test_inventory.json",
    "scripts/tests/test_release_gate_native.py",
    "scripts/release_gate_runtime.py",
    "scripts/tests/test_release_pipeline.py",
    "scripts/tests/test_release_runtime.py",
    "scripts/release_gate_m98.py",
    "scripts/tests/test_release_m98.py"
  ],
  "owned": [
    "crates/*/src/**",
    "crates/*/tests/**",
    "crates/*/examples/**",
    "crates/*/benches/**",
    "crates/*/build.rs",
    "crates/*/assets/**",
    "crates/*/README.md",
    "crates/geosolve-demo-web/frontend/**",
    "packages/geosolve-intent/**",
    "packages/geosolve-sketch-code/**",
    "scripts/verify-geosolve-sketch-code-package.sh",
    "packages/geosolve-engine/**",
    "packages/geosolve-cli/**",
    "packages/geosolve-collaboration/**",
    "scripts/collaboration-*.mjs",
    "scripts/workspace-*.mjs",
    "scripts/file-workspace*.mjs",
    "scripts/geosolve-cli.mjs",
    "scripts/package-m98*.mjs",
    "examples/**"
  ],
  "workers": 3,
  "memory_heavy_workers": 2,
  "test_threads": 2,
  "test_opt_level": 1,
  "debug_assertions": true,
  "overflow_checks": true,
  "cargo_build_jobs": 4,
  "test_debug": "line-tables-only",
  "release_incremental": true,
  "release_codegen_units": 16
}
