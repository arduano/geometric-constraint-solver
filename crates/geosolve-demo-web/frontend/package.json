{
  "name": "geosolve-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "wasm:release": "node scripts/build-wasm.mjs --release",
    "dev:ui": "vite",
    "dev": "npm run wasm && npm run dev:ui",
    "build:ui": "npm run check:language-sdk && tsc -b && vite build",
    "build": "npm run wasm:release && npm run build:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run check:manifest && npm run check:licenses && npm run test:build && npm run test && npm run build",
    "check:manifest": "node scripts/check-sample-manifest.mjs",
    "check:licenses": "node scripts/check-runtime-licenses.mjs",
    "check:language-sdk": "node scripts/sync-language-service-declarations.mjs --check",
    "generate:language-sdk": "node scripts/sync-language-service-declarations.mjs",
    "test:build": "node scripts/test-build-contract.mjs",
    "validate:dist": "node scripts/validate-dist.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lint": "^6.9.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.7",
    "tailwind-merge": "^3.0.2",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.3",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vitest": "^3.0.6"
  }
}
