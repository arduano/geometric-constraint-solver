  "normalizedSource": "\"use geosolve sketch\";\nimport { sketch, mm } from \"@geosolve/sketch-code\";\n\nexport default sketch(($) => {\n  const bar = $.geometry.segment(\"bar\", {\n    start: [0, 0],\n    end: [20, 0],\n  });\n  const horizontal = $.constraint.horizontal(\"horizontal\", {\n    span: bar.span,\n  });\n  const length = $.dimension.pointDistance(\"length\", {\n    first: bar.start,\n    second: bar.end,\n    value: mm(20),\n  });\n  return {\n    bar: bar,\n    horizontal: horizontal,\n    length: length,\n  };\n});\n",
