{
  "name": "@geosolve/cli",
  "version": "0.1.0",
  "description": "Offline local-folder GeoSolve authoring and engine tools",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux"
  ],
  "bin": {
    "geosolve": "bin/geosolve.mjs"
  },
  "files": [
