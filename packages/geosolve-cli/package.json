    "@geosolve/collaboration": "file:../geosolve-collaboration"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:runtime": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
